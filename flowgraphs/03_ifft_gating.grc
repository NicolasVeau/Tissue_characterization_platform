    alias: ''
    comment: ''
    k: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '10'
    vlen: points
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 152]
    rotation: 0
    state: enabled
- name: db_time
  id: blocks_nlog10_ff
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    k: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '10'
    vlen: points
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [899, 375]
    rotation: 0
    state: enabled
- name: f_start
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Start (Hz)
    short_id: ''
    type: eng_float
    value: 300e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [223, 31]
    rotation: 0
    state: enabled
- name: f_stop
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Stop (Hz)
    short_id: ''
    type: eng_float
    value: 1.3e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [364, 30]
    rotation: 0
    state: enabled
- name: fft_fwd
  id: fft_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fft_size: points
    forward: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    nthreads: '1'
    shift: 'False'
    type: complex
    window: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 222]
    rotation: 0
    state: enabled
- name: gate_mult
