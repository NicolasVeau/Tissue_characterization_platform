connections:
- [db_gated, '0', rep_sink_freq_1, '0']
- [db_s11, '0', rep_sink_freq_0, '0']
- [db_time, '0', rep_sink_time_0, '0']
- [fft_fwd, '0', mag2_gated, '0']
- [gate_mult, '0', fft_fwd, '0']
