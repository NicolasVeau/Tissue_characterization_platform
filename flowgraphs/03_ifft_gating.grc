options:
  parameters:
    author: SurTouch
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "IFFT de S11 sans fen\xEAtre (r\xE9ponse temporelle), porte temporelle\
      \ r\xE9glable, retour en fr\xE9quence."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: litevna_03_ifft_gating
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "LiteVNA - r\xE9ponse temporelle et time-gating de S11"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: f_step
  id: variable
  parameters:
    comment: ''
    value: (int(f_stop) - int(f_start)) // (points - 1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1046, 39]
    rotation: 0
    state: enabled
- name: gate
  id: variable
  parameters:
    comment: ''
    value: '[(1.0 if (i < gate_bins or i >= points - gate_bins) else 0.0) / points
      for i in range(points)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1865, 29]
    rotation: 0
    state: enabled
- name: gate_bins
  id: variable
  parameters:
    comment: ''
    value: max(1, int(round(gate_ns / t_step_ns)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1676, 39]
    rotation: 0
    state: enabled
- name: gate_ns
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: '''Porte temporelle (ns)'''
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: t_step_ns
    step: t_step_ns
    stop: points * t_step_ns / 2
    value: '5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1466, 39]
    rotation: 0
    state: enabled
- name: t_step_ns
  id: variable
  parameters:
    comment: ''
    value: 1e9 / (points * f_step)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1256, 39]
    rotation: 0
    state: enabled
- name: averaging
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Averaging
    short_id: ''
    type: intx
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [659, 32]
    rotation: 0
    state: enabled
- name: cal_file
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Fichier .cal (vide = brut)
    short_id: ''
    type: str
    value: '''/home/nveau/vna_app/bench8.cal'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 20]
    rotation: 0
    state: enabled
- name: db_gated
  id: blocks_nlog10_ff
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    k: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '10'
    vlen: points
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1270, 238]
    rotation: 0
    state: enabled
- name: db_s11
  id: blocks_nlog10_ff
