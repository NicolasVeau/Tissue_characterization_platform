options:
  parameters:
    author: SurTouch
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "S11 moins sa moyenne glissante (filtre IIR un p\xF4le par point\
      \ de fr\xE9quence) : fait ressortir les variations."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: litevna_04_diff
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "LiteVNA - diff\xE9rentiel par rapport \xE0 une ligne de base glissante"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: alpha
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: '''Alpha de la ligne de base'''
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '0.005'
    step: '0.005'
    stop: '1'
    value: '0.05'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1237, 16]
    rotation: 0
    state: enabled
- name: f_step
  id: variable
  parameters:
    comment: ''
    value: (int(f_stop) - int(f_start)) // (points - 1)
